---
import SelectorTema from '@/components/SelectorTema.astro';
import { perfil } from '@/data/perfil';

const enlaces = [
  { href: '/#proyectos', texto: 'Proyectos' },
  { href: '/#sobre-mi', texto: 'Sobre mí' },
  { href: '/#contacto', texto: 'Contacto' },
  { href: '/cv', texto: 'CV' },
];
const ruta = Astro.url.pathname;
---

<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__fila">
    <a class="marca" href="/" aria-current={ruta === '/' ? 'page' : undefined}>
      <span class="marca__dorsal" aria-hidden="true">
        10
      </span>
      {perfil.nombreCorto}
    </a>

    <button
      class="menu-boton requiere-js"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-abrir
    >
      Menú
    </button>

    <div class="menu" id="menu-principal" data-menu>
      <nav aria-label="Principal">
        <ul class="menu__lista">
          {enlaces.map((e) => (
            <li>
              <a
                href={e.href}
                aria-current={ruta === e.href ? 'page' : undefined}
                data-seccion={e.href.startsWith('/#') ? e.href.slice(2) : undefined}
              >
                {e.texto}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <SelectorTema />
      <button class="menu-cerrar requiere-js" type="button" data-menu-cerrar>
        Cerrar menú
      </button>
    </div>
  </div>
</header>

<style>
  /*
   * Fija arriba. El fondo translúcido va en un pseudo-elemento: si el backdrop-filter estuviera en la
   * cabecera, el menú móvil (position: fixed) quedaría atrapado dentro de ella.
   */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .cabecera::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--fondo) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  .cabecera[data-scroll]::before {
    border-bottom-color: var(--linea);
  }

  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-5);
    min-height: 4.5rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    font-weight: 800;
    font-stretch: 115%;
    font-size: 1.125rem;
    text-decoration: none;
    padding-block: var(--e-3);
  }

  .menu {
    display: flex;
    align-items: center;
    gap: var(--e-6);
  }

  .menu__lista {
    display: flex;
    gap: var(--e-1);
    list-style: none;
    padding: 0;
  }

  .menu__lista a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--e-3);
    font-weight: 550;
    text-decoration: none;
  }

  /* El dorsal del 10 junto al nombre: la misma ficha de la pizarra. */
  .marca__dorsal {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--azul);
    color: var(--hielo);
    font-size: 0.8125rem;
    font-weight: 900;
    font-stretch: 125%;
    transition: transform var(--dur-media) var(--curva-rebote);
  }

  .marca:hover .marca__dorsal {
    transform: rotate(-12deg) scale(1.1);
  }

  .menu__lista a {
    position: relative;
  }

  /* Subrayado que crece desde el centro; queda puesto en la sección que se está leyendo. */
  .menu__lista a::after {
    content: '';
    position: absolute;
    left: var(--e-3);
    right: var(--e-3);
    bottom: 0.55rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform var(--dur-media) var(--curva);
  }

  .menu__lista a:hover::after,
  .menu__lista a[aria-current]::after {
    transform: scaleX(1);
  }

  .menu__lista a[aria-current] {
    color: var(--accion);
  }

  .menu-boton,
  .menu-cerrar {
    display: none;
  }

  /* Móvil: el menú es un panel a pantalla completa con el foco atrapado (ver script). */
  @media (max-width: 47.99rem) {
    html.js .menu-boton {
      display: inline-flex;
    }

    html.js .menu {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu);
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--e-7);
      padding: var(--e-8) var(--margen);
      background: var(--fondo);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--dur-media) var(--curva),
        visibility 0s linear var(--dur-media);
    }

    html.js .menu[data-abierto] {
      visibility: visible;
      opacity: 1;
      transition: opacity var(--dur-media) var(--curva);
    }

    html.js .menu__lista {
      flex-direction: column;
      gap: var(--e-2);
    }

    html.js .menu__lista a::after {
      left: 0;
      right: 0;
      bottom: 0.2rem;
    }

    html.js .menu__lista a {
      font-size: var(--t-4);
      font-weight: 800;
      font-stretch: 115%;
      padding-inline: 0;
    }

    html.js .menu-cerrar {
      display: inline-flex;
      position: absolute;
      top: var(--e-4);
      right: var(--margen);
    }

    /* Sin JS: los enlaces se envuelven en varias líneas. */
    html:not(.js) .cabecera__fila {
      flex-wrap: wrap;
    }

    html:not(.js) .menu {
      flex-wrap: wrap;
      gap: var(--e-3);
    }
  }

  .menu-boton,
  .menu-cerrar {
    align-items: center;
    min-height: 2.75rem;
    padding: var(--e-2) var(--e-4);
    border: var(--trazo) solid var(--tinta);
    border-radius: var(--radio-boton);
    background: transparent;
    font-weight: 650;
    cursor: pointer;
  }
</style>

<script>
  // Sombra al bajar y sección activa en el menú (solo en el inicio, donde están las secciones).
  const cabecera = document.querySelector<HTMLElement>('[data-cabecera]');
  if (cabecera) {
    const marcar = () => cabecera.toggleAttribute('data-scroll', window.scrollY > 8);
    marcar();
    window.addEventListener('scroll', marcar, { passive: true });
  }

  const enlacesSeccion = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-seccion]'));
  const secciones = enlacesSeccion
    .map((a) => document.getElementById(a.dataset.seccion!))
    .filter((s): s is HTMLElement => s !== null);
  if (secciones.length > 0) {
    const visibles = new Set<string>();
    const obs = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((en) =>
          en.isIntersecting ? visibles.add(en.target.id) : visibles.delete(en.target.id),
        );
        // La primera sección visible en orden del documento es la activa.
        const activa = secciones.find((s) => visibles.has(s.id))?.id;
        enlacesSeccion.forEach((a) => {
          if (a.dataset.seccion === activa) a.setAttribute('aria-current', 'location');
          else if (a.getAttribute('aria-current') === 'location') a.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    secciones.forEach((s) => obs.observe(s));
  }

  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-abrir]');
  const cerrar = document.querySelector<HTMLButtonElement>('[data-menu-cerrar]');
  const movil = window.matchMedia('(max-width: 47.99rem)');

  if (menu && abrir && cerrar) {
    const enfocables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.offsetParent !== null,
      );

    const alTeclear = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        cerrarMenu();
        return;
      }
      if (e.key !== 'Tab') return;
      const lista = enfocables();
      const primero = lista[0];
      const ultimo = lista[lista.length - 1];
      if (!primero || !ultimo) return;
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    };

    function abrirMenu() {
      menu!.setAttribute('data-abierto', '');
      menu!.setAttribute('role', 'dialog');
      menu!.setAttribute('aria-modal', 'true');
      menu!.setAttribute('aria-label', 'Menú');
      abrir!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', alTeclear);
      enfocables()[0]?.focus();
    }

    function cerrarMenu({ devolverFoco = true } = {}) {
      if (!menu!.hasAttribute('data-abierto')) return;
      menu!.removeAttribute('data-abierto');
      menu!.removeAttribute('role');
      menu!.removeAttribute('aria-modal');
      menu!.removeAttribute('aria-label');
      abrir!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', alTeclear);
      if (devolverFoco) abrir!.focus();
    }

    abrir.addEventListener('click', abrirMenu);
    cerrar.addEventListener('click', () => cerrarMenu());
    // Al elegir un enlace, se cierra y el navegador lleva el foco al destino.
    menu
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => cerrarMenu({ devolverFoco: false })));
    movil.addEventListener('change', (e) => {
      if (!e.matches) cerrarMenu({ devolverFoco: false });
    });
  }
</script>
