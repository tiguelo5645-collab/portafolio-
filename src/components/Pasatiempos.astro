---
/**
 * Fuera del código: los pasatiempos en texto corto y una guitarra que suena.
 * La guitarra funciona con mouse, toque y teclado; sin JavaScript queda el texto.
 */
import { pasatiempos } from '@/data/perfil';

/** Afinación estándar, de la sexta cuerda (la más grave) a la primera. */
const cuerdas = [
  { nota: 'Mi', frecuencia: 82.41, grosor: 3 },
  { nota: 'La', frecuencia: 110, grosor: 2.6 },
  { nota: 'Re', frecuencia: 146.83, grosor: 2.2 },
  { nota: 'Sol', frecuencia: 196, grosor: 1.8 },
  { nota: 'Si', frecuencia: 246.94, grosor: 1.5 },
  { nota: 'Mi agudo', frecuencia: 329.63, grosor: 1.2 },
];
---

<section class="seccion" id="fuera-del-codigo" aria-labelledby="fuera-titulo">
  <div class="contenedor fuera">
    <div>
      <h2 id="fuera-titulo" class="titulo-seccion">
        Fuera del código
      </h2>
      <dl class="lista">
        {pasatiempos.map((p) => (
          <div class="lista__item revelar">
            <dt>{p.titulo}</dt>
            <dd>{p.texto}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="guitarra requiere-js revelar" data-guitarra>
      <div class="mastil" role="group" aria-label="Cuerdas de la guitarra">
        {cuerdas.map((c) => (
          <button
            type="button"
            class="cuerda"
            style={`--grosor: ${c.grosor}px`}
            data-frecuencia={c.frecuencia}
          >
            <span class="cuerda__linea" aria-hidden="true" />
            <span class="cuerda__nota">{c.nota}</span>
          </button>
        ))}
        <span class="mastil__boca" aria-hidden="true"></span>
      </div>
      <figcaption class="guitarra__pie">
        <span>Las cuerdas suenan: tócalas con el mouse, el dedo o el teclado.</span>
        <button type="button" class="boton guitarra__rasguear" data-rasguear>
          Rasguear
        </button>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .fuera {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e-8);
    align-items: start;
  }

  .lista {
    display: grid;
    border-top: 1px solid var(--linea);
  }

  .lista__item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--e-4);
    padding-block: var(--e-4);
    border-bottom: 1px solid var(--linea);
  }

  .lista dt {
    font-weight: 700;
    font-stretch: 110%;
  }

  .lista dd {
    margin: 0;
    color: var(--tinta-suave);
  }

  .guitarra {
    display: grid;
    gap: var(--e-4);
  }

  /* El mástil: madera oscura, la boca de la guitarra detrás y seis cuerdas que son botones. */
  .mastil {
    position: relative;
    display: grid;
    padding-block: var(--e-2);
    border-radius: var(--radio-imagen);
    background: linear-gradient(90deg, #3b2412, #573a20 50%, #3b2412);
    box-shadow: var(--sombra);
    overflow: hidden;
    touch-action: none;
  }

  .mastil__boca {
    position: absolute;
    top: 50%;
    left: 64%;
    width: 7rem;
    height: 7rem;
    margin: -3.5rem 0 0 -3.5rem;
    border-radius: 50%;
    background: #1a0f06;
    box-shadow: 0 0 0 5px #b58a52;
    pointer-events: none;
  }

  .cuerda {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--e-3);
    border: 0;
    background: none;
    color: #f0d9b5;
    cursor: pointer;
  }

  .cuerda:focus-visible {
    outline-color: #f0d9b5;
    outline-offset: -3px;
  }

  .cuerda__linea {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: var(--grosor);
    margin-top: calc(var(--grosor) / -2);
    background: linear-gradient(#ececec, #9a9a9a);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }

  .cuerda__nota {
    position: relative;
    padding: 0 6px;
    border-radius: var(--radio-boton);
    background: rgb(26 15 6 / 0.85);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .cuerda.sonando .cuerda__linea {
    background: linear-gradient(#f3e3c3, #c9a46a);
    animation: vibrar 420ms linear;
  }

  @keyframes vibrar {
    0%,
    100% {
      transform: none;
    }
    10%,
    50%,
    90% {
      transform: translateY(-1.5px) scaleY(1.5);
    }
    30%,
    70% {
      transform: translateY(1.5px) scaleY(1.5);
    }
  }

  .guitarra__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }

  @media (max-width: 55rem) {
    .fuera {
      grid-template-columns: 1fr;
      gap: var(--e-6);
    }
  }

  @media (max-width: 30rem) {
    .lista__item {
      grid-template-columns: 1fr;
      gap: var(--e-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cuerda.sonando .cuerda__linea {
      animation: none;
    }
  }
</style>

<script>
  // Guitarra: síntesis Karplus-Strong, una cuerda pulsada hecha con ruido que se promedia y se apaga.
  document.querySelectorAll<HTMLElement>('[data-guitarra]').forEach((caja) => {
    const cuerdas = Array.from(caja.querySelectorAll<HTMLButtonElement>('[data-frecuencia]'));
    const mastil = caja.querySelector<HTMLElement>('.mastil')!;
    let audio: AudioContext | null = null;
    const sonidos = new Map<number, AudioBuffer>();

    /** Genera (y guarda) el sonido de una cuerda. */
    const sonidoDe = (ac: AudioContext, frecuencia: number) => {
      const guardado = sonidos.get(frecuencia);
      if (guardado) return guardado;
      const tasa = ac.sampleRate;
      const largo = Math.floor(tasa * 2.2);
      const buffer = ac.createBuffer(1, largo, tasa);
      const datos = buffer.getChannelData(0);
      const periodo = Math.round(tasa / frecuencia);
      for (let i = 0; i < periodo; i++) datos[i] = Math.random() * 2 - 1;
      for (let i = periodo; i < largo; i++) {
        datos[i] = 0.497 * (datos[i - periodo]! + datos[i - periodo + 1]!);
      }
      sonidos.set(frecuencia, buffer);
      return buffer;
    };

    const pulsar = (cuerda: HTMLButtonElement) => {
      // El navegador solo deja sonar audio después de una acción de la persona: se crea aquí.
      audio ??= new AudioContext();
      if (audio.state === 'suspended') void audio.resume();
      const fuente = audio.createBufferSource();
      fuente.buffer = sonidoDe(audio, Number(cuerda.dataset.frecuencia));
      const volumen = audio.createGain();
      volumen.gain.value = 0.35;
      fuente.connect(volumen).connect(audio.destination);
      fuente.start();

      // La cuerda se enciende mientras vibra y luego vuelve a su color.
      cuerda.classList.remove('sonando');
      void cuerda.offsetWidth;
      cuerda.classList.add('sonando');
      window.clearTimeout(Number(cuerda.dataset.apagar));
      cuerda.dataset.apagar = String(window.setTimeout(() => cuerda.classList.remove('sonando'), 450));
    };

    cuerdas.forEach((c) => {
      // Un clic (o Enter/Espacio) toca la cuerda. Al arrastrar, el clic no llega a las cuerdas que se cruzan.
      c.addEventListener('click', () => pulsar(c));
      // Con el mouse presionado, cada cuerda que se cruza suena: eso es rasguear.
      c.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && e.buttons === 1) pulsar(c);
      });
    });

    // En pantallas táctiles el dedo no dispara pointerenter al cruzar: se busca la cuerda bajo el dedo.
    let ultima: Element | null = null;
    const cuerdaBajo = (e: PointerEvent) =>
      document.elementFromPoint(e.clientX, e.clientY)?.closest('[data-frecuencia]') ?? null;
    // La cuerda donde empieza el toque ya suena con el clic: se marca para no repetirla.
    mastil.addEventListener('pointerdown', (e) => (ultima = cuerdaBajo(e)));
    mastil.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'touch') return;
      const debajo = cuerdaBajo(e);
      if (debajo && debajo !== ultima) pulsar(debajo as HTMLButtonElement);
      ultima = debajo;
    });
    mastil.addEventListener('pointerup', () => (ultima = null));
    mastil.addEventListener('pointercancel', () => (ultima = null));

    caja.querySelector('[data-rasguear]')!.addEventListener('click', () => {
      cuerdas.forEach((c, i) => window.setTimeout(() => pulsar(c), i * 35));
    });
  });
</script>
