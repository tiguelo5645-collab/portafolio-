---
import { Image } from 'astro:assets';
import { obtenerProyectos } from '@/lib/proyectos';
import { tecnologias } from '@/data/perfil';
import { posiciones } from '@/data/cancha';

const proyectos = await obtenerProyectos();

// Filtro: solo tecnologías que aparecen en algún proyecto destacado.
const filtros = tecnologias.enProyectos.filter((t) =>
  t.proyectos?.some((slug) => proyectos.some((p) => p.id === slug)),
);
const tecnologiasDe = (slug: string) =>
  filtros.filter((t) => t.proyectos?.includes(slug)).map((t) => t.nombre);
---

<section class="seccion" id="proyectos" aria-labelledby="proyectos-titulo">
  <div class="contenedor">
    <div class="cabeza">
      <h2 id="proyectos-titulo" class="titulo-seccion">
        Proyectos
      </h2>
      <div class="filtro requiere-js" role="group" aria-label="Filtrar proyectos por tecnología" data-filtro>
        <button type="button" class="chip" aria-pressed="true" data-tec="">
          Todas
        </button>
        {filtros.map((t) => (
          <button type="button" class="chip" aria-pressed="false" data-tec={t.nombre}>
            {t.nombre}
          </button>
        ))}
      </div>
      <p class="filtro__estado" role="status" data-filtro-estado></p>
    </div>

    <ul class="proyectos" role="list">
      {proyectos.map((p) => {
        const pos = posiciones[p.id];
        return (
          <li class="proyecto revelar" data-proyecto data-tecnologias={JSON.stringify(tecnologiasDe(p.id))}>
            <div class="proyecto__texto">
              <p class="proyecto__area">
                <span>{pos ? `${pos.puesto} · ${p.data.area}` : p.data.area}</span>
              </p>
              <h3 class="proyecto__nombre">
                <a href={`/proyectos/${p.id}`} class="proyecto__enlace">
                  {p.data.titulo}
                </a>
              </h3>
              <p class="proyecto__resumen">{p.data.resumen}</p>
              <p class="proyecto__stack">
                <span class="solo-lectores">Tecnologías: </span>
                {p.data.stack.slice(0, 5).join(' · ')}
              </p>
              <span class="proyecto__ver" aria-hidden="true">
                Ver caso de estudio
                <svg width="16" height="16" viewBox="0 0 18 18">
                  <path d="M3 9h11M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </span>
            </div>
            {p.data.portada ? (
              <Image
                class="proyecto__imagen"
                src={p.data.portada.src}
                alt=""
                widths={[320, 480, 720]}
                sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 40vw, 90vw"
                loading="lazy"
              />
            ) : (
              // Sin captura publicada: una mini pizarra con el dorsal.
              <div class="proyecto__imagen proyecto__pizarra" aria-hidden="true">
                <span class="proyecto__pizarra-dorsal">{pos?.dorsal ?? ''}</span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .cabeza {
    display: grid;
    gap: var(--e-4);
    margin-bottom: var(--e-6);
  }

  .cabeza .titulo-seccion {
    margin-bottom: 0;
  }

  .filtro {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .chip {
    min-height: 2.5rem;
    padding: var(--e-1) var(--e-4);
    border: 1px solid var(--linea);
    border-radius: var(--radio-boton);
    background: transparent;
    font-weight: 550;
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      background-color var(--dur-corta) var(--curva),
      border-color var(--dur-corta) var(--curva),
      color var(--dur-corta) var(--curva);
  }

  .chip:hover {
    border-color: var(--tinta-suave);
  }

  .chip[aria-pressed='true'] {
    background: var(--tinta);
    border-color: var(--tinta);
    color: var(--fondo);
  }

  .filtro__estado {
    min-height: 1.6em;
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }

  .proyectos {
    display: grid;
    gap: var(--e-4);
    list-style: none;
    padding: 0;
  }

  .proyecto {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    align-items: center;
    gap: var(--e-7);
    padding: var(--e-6);
    border: 1px solid var(--linea);
    border-radius: var(--radio-tarjeta);
    background: var(--superficie);
    transition:
      border-color var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva),
      translate var(--dur-media) var(--curva),
      opacity var(--dur-media) var(--curva);
  }

  .proyecto:hover {
    border-color: color-mix(in srgb, var(--accion) 45%, transparent);
    box-shadow: var(--sombra);
    translate: 0 -2px;
  }

  .proyecto.atenuado {
    opacity: 0.4;
  }

  .proyecto__area {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1) var(--e-2);
    color: var(--tinta-suave);
    font-size: 0.875rem;
    font-weight: 550;
  }

  .proyecto__nombre {
    margin-top: var(--e-3);
    font-size: var(--t-4);
    font-stretch: 110%;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .proyecto__enlace {
    text-decoration: none;
    transition: color var(--dur-corta) var(--curva);
  }

  /* Toda la tarjeta es el enlace. */
  .proyecto__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .proyecto:hover .proyecto__enlace {
    color: var(--accion);
  }

  .proyecto__enlace:focus-visible {
    outline: none;
  }

  .proyecto:has(.proyecto__enlace:focus-visible) {
    outline: 3px solid var(--accion);
    outline-offset: 3px;
  }

  .proyecto__resumen {
    margin-top: var(--e-3);
    font-size: 1.125rem;
    line-height: 1.45;
    max-width: 46ch;
  }

  .proyecto__stack {
    margin-top: var(--e-4);
    color: var(--tinta-suave);
    font-size: 0.875rem;
  }

  .proyecto__ver {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    margin-top: var(--e-5);
    color: var(--accion);
    font-weight: 650;
    font-size: 0.9375rem;
  }

  .proyecto__ver svg {
    transition: translate var(--dur-media) var(--curva);
  }

  .proyecto:hover .proyecto__ver svg {
    translate: 4px 0;
  }

  .proyecto__imagen {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radio-imagen);
    background: var(--marino);
  }

  /* Mini pizarra para los proyectos sin captura: franjas suaves, línea y círculo central, y el dorsal. */
  .proyecto__pizarra {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 50%, transparent 2.9rem, var(--cal) 3rem, transparent 3.08rem),
      linear-gradient(90deg, transparent calc(50% - 1px), var(--cal) 0 calc(50% + 1px), transparent 0),
      repeating-linear-gradient(90deg, var(--cancha) 0 2.5rem, var(--cancha-2) 2.5rem 5rem);
    box-shadow:
      inset 0 0 0 0.6rem var(--cancha),
      inset 0 0 0 calc(0.6rem + 1.5px) var(--cal);
  }

  .proyecto__pizarra-dorsal {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--azul);
    border: 2px solid var(--cal);
    color: var(--hielo);
    font-size: 1.5rem;
    font-weight: 850;
    font-stretch: 115%;
  }

  @media (max-width: 47.99rem) {
    .proyecto {
      grid-template-columns: 1fr;
      gap: var(--e-5);
      padding: var(--e-5);
    }

    .proyecto__imagen {
      order: -1;
    }
  }
</style>

<script>
  const filtro = document.querySelector<HTMLElement>('[data-filtro]');
  const estado = document.querySelector<HTMLElement>('[data-filtro-estado]');
  const filas = Array.from(document.querySelectorAll<HTMLElement>('[data-proyecto]'));

  filtro?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tec]');
    if (!chip) return;
    const tec = chip.dataset.tec ?? '';
    filtro.querySelectorAll('[data-tec]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));

    let cuantos = 0;
    filas.forEach((fila) => {
      const usa = !tec || (JSON.parse(fila.dataset.tecnologias ?? '[]') as string[]).includes(tec);
      fila.classList.toggle('atenuado', !usa);
      if (usa) cuantos++;
    });

    if (estado) {
      estado.textContent = tec
        ? `${cuantos} ${cuantos === 1 ? 'proyecto usa' : 'proyectos usan'} ${tec}.`
        : '';
    }
  });
</script>
