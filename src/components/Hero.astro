---
import Cancha from '@/components/Cancha.astro';
import { perfil } from '@/data/perfil';
import { obtenerProyectos } from '@/lib/proyectos';

/** El nombre en dos líneas: nombres en tinta, apellidos en azul (el nombre en la espalda de la camiseta). */
const lineas = [
  { texto: 'Miguel Ángel', clase: '' },
  { texto: 'Pantoja Guerra', clase: 'hero__linea--apellidos' },
];

/** Marcador: solo datos comprobables, sacados del perfil y de los proyectos publicados. */
const marcador = [
  { valor: String((await obtenerProyectos()).length), texto: 'proyectos publicados' },
  { valor: '4', texto: 'plataformas: reloj, móvil, web y juego' },
  { valor: perfil.grado.match(/\d{4}/)?.[0] ?? '', texto: 'año de grado' },
];
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="contenedor hero__rejilla">
    <div class="hero__texto">
      <p class="hero__rol">
        {perfil.rol} · {perfil.ciudad}
      </p>
      <h1 id="hero-titulo" class="hero__nombre">
        {lineas.map((l, i) => (
          <span class:list={['hero__linea', l.clase]} style={`--i:${i}`}>
            {l.texto}
          </span>
        ))}
      </h1>
      <p class="hero__que-hago">{perfil.queHago}</p>
      <p class="hero__disponible">{perfil.disponibilidad}</p>
      <div class="hero__acciones">
        <a class="boton boton--principal" href="#contacto">
          {' '}
          Escríbeme{' '}
        </a>
        <a class="boton" href="/cv">
          {' '}
          Ver mi CV{' '}
        </a>
      </div>
      <dl class="marcador">
        {marcador.map((m) => (
          <div class="marcador__dato">
            <dt>{m.texto}</dt>
            <dd>{m.valor}</dd>
          </div>
        ))}
      </dl>
    </div>

    <Cancha />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--e-8) var(--e-9);
  }

  .hero__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--e-9);
    align-items: center;
  }

  .hero__texto {
    container-type: inline-size;
  }

  .hero__rol {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    color: var(--tinta-suave);
    font-weight: 550;
    font-size: 0.9375rem;
  }

  .hero__rol::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--resalte);
  }

  .hero__nombre {
    margin-top: var(--e-5);
    /* Medido para que «PANTOJA GUERRA» quepa en una línea dentro de la columna. */
    font-size: min(8.4cqi, 4.75rem);
    font-weight: 850;
    font-stretch: 110%;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--tinta);
    text-wrap: initial;
  }

  .hero__linea {
    display: block;
    animation: entrar var(--dur-larga) var(--curva) backwards;
    animation-delay: calc(var(--i) * 80ms + 80ms);
  }

  .hero__linea--apellidos {
    color: var(--accion);
  }

  @keyframes entrar {
    from {
      opacity: 0;
      translate: 0 0.2em;
    }
  }

  .hero__que-hago {
    margin-top: var(--e-6);
    font-size: var(--t-2);
    font-weight: 600;
    line-height: 1.3;
    max-width: 30ch;
  }

  .hero__disponible {
    margin-top: var(--e-2);
    color: var(--tinta-suave);
    max-width: 40ch;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
  }

  /* Marcador: tres datos en línea, separados por una raya fina. Sin caja: que no compita con la cancha. */
  .marcador {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-5) var(--e-6);
    margin-top: var(--e-7);
    padding-top: var(--e-5);
    border-top: 1px solid var(--linea);
  }

  .marcador__dato {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  .marcador__dato + .marcador__dato {
    padding-left: var(--e-6);
    border-left: 1px solid var(--linea);
  }

  /* El número va arriba (order) aunque en el HTML la etiqueta va primero, como pide <dl>. */
  .marcador dd {
    order: -1;
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    font-stretch: 110%;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .marcador dt {
    max-width: 16ch;
    font-size: var(--t-0);
    line-height: 1.35;
    color: var(--tinta-suave);
  }

  @media (max-width: 64rem) {
    .hero__rejilla {
      grid-template-columns: 1fr;
      gap: var(--e-8);
    }

    .hero__nombre {
      font-size: min(10cqi, 4.75rem);
    }
  }

  @media (max-width: 30rem) {
    .marcador__dato + .marcador__dato {
      padding-left: var(--e-4);
    }

    .marcador {
      gap: var(--e-4);
    }
  }
</style>
